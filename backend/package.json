{
  "name": "rentz-arena-backend",
  "version": "1.0.0",
  "description": "Backend for Rentz Arena",
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude 'tests/**/*.integration.test.js'",
    "test:integration": "vitest run integration.test.js --passWithNoTests",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@langchain/ollama": "^0.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "nodemailer": "^6.9.4",
    "socket.io": "^4.7.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "mongodb-memory-server": "^11.1.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.7"
  }
}
